{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start Git Auto-Sync",
            "type": "shell",
            "command": "powershell.exe",
            "args": [
                "-NoLogo",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/scripts/auto-sync.ps1"
            ],
            "isBackground": true,
            "problemMatcher": [],
            "runOptions": {
                "runOn": "folderOpen"
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": false,
                "clear": false
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
